# ARM64 build. The upstream puppeteer base image is amd64-only
# (Chrome for Testing publishes no linux/arm64 binary), so on aarch64 Chrome is
# replaced by Debian's chromium and everything else matches ./Dockerfile.
FROM node:22-bookworm-slim
ENV OUT_DIR=/output
WORKDIR /app
# Debian's chromium is the maintained headless Chrome on arm64. The slim base
# ships no fonts, and Chromium refuses to paint text without at least one family.
RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium fonts-liberation ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
# Chromium comes from apt above; puppeteer's own download is both unused here
# (PUPPETEER_EXECUTABLE_PATH below) and unavailable for this architecture.
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN npm ci
COPY scrape.js analyze.js ./
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# node:22 already owns uid 1000 (user `node`), the same uid as the amd64 image's
# pptruser, so /output files land with identical ownership on either arch.
USER 1000:1000
ENTRYPOINT ["node", "scrape.js"]
