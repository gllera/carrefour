# Copy to .env (gitignored) and fill in. run.sh and publish-dmz.sh source it.

# Postal code whose prices to scrape (required).
SCRAPE_POSTAL_CODE=28001
# Store to check product availability against: the first field of the
# `salepoint` cookie carrefour.es sets once a postal code is chosen.
# Leave empty to skip the check.
SCRAPE_STORE_ID=

# Where publish-dmz.sh copies the page: an ssh destination and the directory
# its web server serves.
CARREFOUR_DMZ_HOST=user@web-server
CARREFOUR_DMZ_DIR=/var/www/carrefour
